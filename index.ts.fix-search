import { Server } from "@modelcontextprotocol/sdk/server/index.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import {
  CallToolRequestSchema,
  ListToolsRequestSchema,
} from "@modelcontextprotocol/sdk/types.js";
import { z } from "zod";
import * as lancedb from "@lancedb/lancedb";
import { runJxa } from "run-jxa";
import path from "node:path";
import os from "node:os";
import TurndownService from "turndown";
import {
  EmbeddingFunction,
  LanceSchema,
  register,
} from "@lancedb/lancedb/embedding";
import { type Float, Float32, Utf8 } from "apache-arrow";

// ============================================
// OLLAMA CONFIGURATION - Change model here if needed
// ============================================
const OLLAMA_BASE_URL = "http://localhost:11434";
const OLLAMA_EMBEDDING_MODEL = "nomic-embed-text"; // or "all-minilm" or "mxbai-embed-large"

// ============================================
// Ollama Embedding Function (replaces HuggingFace)
// ============================================
async function getOllamaEmbedding(text: string): Promise<number[]> {
  const response = await fetch(`${OLLAMA_BASE_URL}/api/embeddings`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      model: OLLAMA_EMBEDDING_MODEL,
      prompt: text,
    }),
  });

  if (!response.ok) {
    throw new Error(`Ollama API error: ${response.status} ${response.statusText}`);
  }

  const data = await response.json();
  return data.embedding;
}

// Get embedding dimension by making a test call
async function getEmbeddingDimension(): Promise<number> {
  const testEmbedding = await getOllamaEmbedding("test");
  return testEmbedding.length;
}

const turndownService = new TurndownService();
const db = await lancedb.connect(
  path.join(os.homedir(), ".mcp-apple-notes", "data")
);

// Initialize embedding dimension
let EMBEDDING_DIM = 768; // Default, will be updated on first use
try {
  EMBEDDING_DIM = await getEmbeddingDimension();
  console.error(`Ollama embedding dimension: ${EMBEDDING_DIM}`);
} catch (e) {
  console.error("Warning: Could not connect to Ollama to get embedding dimension. Using default 768.");
}

// ============================================
// Custom Embedding Function for LanceDB using Ollama
// ============================================
@register("ollama")
class OllamaEmbeddingFunction extends EmbeddingFunction<string> {
  toJSON(): object {
    return {};
  }

  ndims(): number {
    return EMBEDDING_DIM;
  }

  embeddingDataType(): Float {
    return new Float32();
  }

  async computeSourceEmbeddings(data: string[]): Promise<number[][] | Float32Array[]> {
    const embeddings: number[][] = [];
    for (const text of data) {
      const embedding = await getOllamaEmbedding(text);
      embeddings.push(embedding);
    }
    return embeddings;
  }
}

const embeddingFunction = new OllamaEmbeddingFunction();

const NotesSchema = LanceSchema({
  title: embeddingFunction.sourceField(new Utf8()),
  content: new Utf8(),
  vector: embeddingFunction.vectorField(),
});

const server = new Server(
  {
    name: "local-machine",
    version: "1.0.0",
  },
  {
    capabilities: {
      tools: {},
    },
  }
);

server.setRequestHandler(ListToolsRequestSchema, async () => {
  return {
    tools: [
      {
        name: "list-notes",
        description: "Lists just the titles of all my Apple Notes",
        inputSchema: {
          type: "object",
          properties: {},
          required: [],
        },
      },
      {
        name: "index-notes",
        description:
          "Index all my Apple Notes for Semantic Search. Please tell the user that the sync takes couple of seconds up to couple of minutes depending on how many notes you have.",
        inputSchema: {
          type: "object",
          properties: {},
          required: [],
        },
      },
      {
        name: "get-note",
        description: "Get a note full content and details by title",
        inputSchema: z.object({
          title: z.string(),
        }),
      },
      {
        name: "search-notes",
        description: "Search for notes by title or content",
        inputSchema: z.object({
          query: z.string(),
        }),
      },
      {
        name: "create-note",
        description:
          "Create a new Apple Note with specified title and content. Must be in HTML format WITHOUT newlines",
        inputSchema: {
          type: "object",
          properties: {
            title: { type: "string" },
            content: { type: "string" },
          },
          required: ["title", "content"],
        },
      },
    ],
  };
});

server.setRequestHandler(CallToolRequestSchema, async (request) => {
  const { name, arguments: args } = request.params;

  if (name === "list-notes") {
    const notes = await runJxa(`
      const app = Application('Notes');
      return app.notes().map(note => note.name());
    `);
    return {
      content: [{ type: "text", text: JSON.stringify(notes, null, 2) }],
    };
  }

  if (name === "index-notes") {
    const startTime = Date.now();

    // Fetch all notes
    const notes = (await runJxa(`
      const app = Application('Notes');
      return app.notes().map(note => ({
        name: note.name(),
        body: note.body(),
      }));
    `)) as { name: string; body: string }[];

    // Process notes and create embeddings
    const processedNotes = notes.map((note) => ({
      title: note.name,
      content: turndownService.turndown(note.body),
    }));

    // Check if table exists and drop it
    const existingTables = await db.tableNames();
    if (existingTables.includes("notes")) {
      await db.dropTable("notes");
    }

    // Create table with embeddings (Ollama will be called via the embedding function)
    const table = await db.createTable("notes", processedNotes, {
      schema: NotesSchema,
    });

    const time = Date.now() - startTime;
    const chunks = processedNotes.length;

    return {
      content: [
        {
          type: "text",
          text: `Indexed ${chunks} notes chunks in ${time}ms.`,
        },
      ],
    };
  }

  if (name === "get-note") {
    const { title } = args as { title: string };
    const note = await runJxa(
      `
      const app = Application('Notes');
      const notes = app.notes.whose({name: $params.title});
      if (notes.length > 0) {
        const note = notes[0];
        return {
          name: note.name(),
          body: note.body(),
          creationDate: note.creationDate().toISOString(),
          modificationDate: note.modificationDate().toISOString()
        };
      }
      return null;
    `,
      { title }
    );

    if (!note) {
      return {
        content: [{ type: "text", text: `Note "${title}" not found` }],
      };
    }

    return {
      content: [{ type: "text", text: JSON.stringify(note, null, 2) }],
    };
  }

  if (name === "search-notes") {
    const { query } = args as { query: string };
    const existingTables = await db.tableNames();

    if (!existingTables.includes("notes")) {
      return {
        content: [
          {
            type: "text",
            text: "Notes have not been indexed yet. Please run index-notes first.",
          },
        ],
      };
    }

    const table = await db.openTable("notes");
    
    // Get query embedding from Ollama
    const queryEmbedding = await getOllamaEmbedding(query);
    
    // Search and SELECT only title and content (exclude the vector!)
    const results = await table
      .search(queryEmbedding)
      .select(["title", "content"])  // Only return these fields, NOT the vector
      .limit(10)
      .toArray();

    // Format results nicely for Claude
    const formattedResults = results.map((r: any, i: number) => ({
      rank: i + 1,
      title: r.title,
      // Truncate content to first 500 chars in search results
      content_preview: r.content.length > 500 
        ? r.content.substring(0, 500) + "... [truncated - use get-note for full content]"
        : r.content,
      // _distance is the similarity score (lower = more similar)
      relevance: r._distance ? `${(1 - r._distance).toFixed(2)}` : "N/A"
    }));

    return {
      content: [{ type: "text", text: JSON.stringify(formattedResults, null, 2) }],
    };
  }

  if (name === "create-note") {
    const { title, content } = args as { title: string; content: string };
    await runJxa(
      `
      const app = Application('Notes');
      const note = app.Note({name: $params.title, body: $params.content});
      app.notes.push(note);
      return true;
    `,
      { title, content }
    );

    return {
      content: [
        { type: "text", text: `Note "${title}" created successfully` },
      ],
    };
  }

  throw new Error(`Unknown tool: ${name}`);
});

const transport = new StdioServerTransport();
await server.connect(transport);

console.error("Apple Notes MCP Server (Ollama Edition) running on stdio");

